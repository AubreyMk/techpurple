// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  roleId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   String @id @default(cuid())
  name String @unique
}

model Service {
  id          String @id @default(cuid())
  name        String
  description String
}

model HostingPlan {
  id       String @id @default(cuid())
  name     String
  price    Float
  features String // JSON string
}

model Project {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  category    String
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PhotographyPackage {
  id       String @id @default(cuid())
  name     String
  price    Float
  features String // JSON string
}
